{
  "manifest_version": 3,
  "name": "Search on Youtube",
  "browser_specific_settings": {
    "gecko": {
      "id": "@search-youtube.padd_",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "version": "0.9.1",
  "description": "Search for selected text directly on YouTube: use the context menu to search YouTube for any text selected from a web page.",
  "permissions": [
    "contextMenus",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
